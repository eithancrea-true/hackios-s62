+static void
+keys_add_gpio(uint16_t sid, unsigned n)
+{
+	struct keys_gpio *g = &keys_gpio[keys_ngpio];
+	uint8_t type = 0, subtype = 0, mode = 0, en = 0;
+	g->ppid = (uint16_t)((unsigned)sid << 8 | (0xc0u + n - 1u));
+	g->code = (uint16_t)(((unsigned)sid << 8) | n);
+	g->apid = keys_find_apid(g->ppid);
+	g->obs = keys_obs_map(g->apid);
+	g->last = -1;
+	uint16_t base = (uint16_t)((g->ppid & 0xffu) << 8);
+	if (!keys_read(g->obs, base | 0x04u, &type) || type != 0x10u ||
+	    !keys_read(g->obs, base | 0x05u, &subtype) ||
+	    !keys_read(g->obs, base | 0x40u, &mode) ||
+	    !keys_read(g->obs, base | 0x46u, &en)) {
+		return;
+	}
+	bool lvmv = subtype >= 0x10u && subtype <= 0x13u;
+	unsigned dir = lvmv ? (mode >> 4) & 3u : (mode >> 4) & 7u;
+	bool input = (dir == 0 || dir == 2);
+	printf("S62 KEYS: %s gpio%u apid=%u sub=%#x mode=%#x en=%#x%s\n",
+	    sid ? "pm660l" : "pm660", n, g->apid, subtype, mode, en,
+	    ((en & 0x80u) && input) ? " input" : "");
+	if ((en & 0x80u) && input && keys_ngpio < KEYS_NGPIO) {
