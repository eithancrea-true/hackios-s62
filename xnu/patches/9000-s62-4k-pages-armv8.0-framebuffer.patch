+	for (int i = 0; i < 16; i++) {
+		if (e[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Read and fully validate one header and its entries. */
+static int
+gpt_load(uint64_t hlba, uint8_t *hdr, uint8_t *ent, const char *which)
+{
+	int error = emmc_read_blocks(hlba, 1);
+	if (error) {
+		return error;
+	}
+	memcpy(hdr, (void *)(su.dma + DMA_BOUNCE), EMMC_BLOCK);
+	uint32_t hsize = rd32(hdr + 12), hcrc = rd32(hdr + 16);
+	uint32_t nent = rd32(hdr + 80), esz = rd32(hdr + 84);
+	if (memcmp(hdr, "EFI PART", 8) != 0 || hsize < 92 || hsize > EMMC_BLOCK ||
+	    esz != 128 || nent == 0 || nent > 128 || rd64(hdr + 24) != hlba) {
+		printf("GPTEDIT: %s header at 0x%llx invalid\n", which, hlba);
+		return EINVAL;
+	}
+	uint8_t tmp[EMMC_BLOCK];
+	memcpy(tmp, hdr, hsize);
+	wr32(tmp + 16, 0);
+	if (gpt_crc32(tmp, hsize) != hcrc) {
+		printf("GPTEDIT: %s header CRC mismatch\n", which);
+		return EINVAL;
+	}
+	uint32_t bytes = nent * esz, sectors = (bytes + EMMC_BLOCK - 1) / EMMC_BLOCK;
+	error = emmc_read_blocks(rd64(hdr + 72), sectors);
+	if (error) {
+		return error;
+	}
+	memcpy(ent, (void *)(su.dma + DMA_BOUNCE), sectors * EMMC_BLOCK);
+	if (gpt_crc32(ent, bytes) != rd32(hdr + 88)) {
+		printf("GPTEDIT: %s entries CRC mismatch\n", which);
+		return EINVAL;
+	}
+	return 0;
+}
+
+static void
+gpt_seal(uint8_t *hdr, const uint8_t *ent)
+{
+	wr32(hdr + 88, gpt_crc32(ent, rd32(hdr + 80) * rd32(hdr + 84)));
+	wr32(hdr + 16, 0);
+	wr32(hdr + 16, gpt_crc32(hdr, rd32(hdr + 12)));
+}
+
+/* Write sectors from buf, then read them back and compare. */
+static int
+gpt_write_verify(uint64_t lba, const uint8_t *buf, uint32_t sectors, const char *what)
+{
+	memcpy((void *)(su.dma + DMA_BOUNCE), buf, sectors * EMMC_BLOCK);
+	int error = emmc_write_blocks(lba, sectors);
+	if (!error) {
+		bzero((void *)(su.dma + DMA_BOUNCE), sectors * EMMC_BLOCK);
+		error = emmc_read_blocks(lba, sectors);
+	}
+	if (!error && memcmp((void *)(su.dma + DMA_BOUNCE), buf, sectors * EMMC_BLOCK) != 0) {
+		error = EIO;
+	}
+	printf("GPTEDIT: write %s (%u sectors at 0x%llx): %s (%d)\n", what, sectors, lba,
+	    error ? "FAILED" : "verified", error);
+	return error;
+}
+
+static int
+emmc_gpt_split(uint32_t mode, uint32_t mib)
+{
+	int error;
+	if ((error = gpt_load(1, gpt_ph, gpt_ent, "primary"))) {
+		return error;
+	}
+	uint64_t alt = rd64(gpt_ph + 32);
+	if ((error = gpt_load(alt, gpt_bh, gpt_bent, "backup"))) {
+		return error;
+	}
+	uint32_t nent = rd32(gpt_ph + 80), esz = rd32(gpt_ph + 84);
+	uint32_t esec = (nent * esz + EMMC_BLOCK - 1) / EMMC_BLOCK;
+	if (rd64(gpt_bh + 32) != 1 || rd32(gpt_bh + 80) != nent ||
+	    memcmp(gpt_ent, gpt_bent, nent * esz) != 0) {
+		printf("GPTEDIT: primary and backup GPT differ, not touching anything\n");
+		return EINVAL;
+	}
+	printf("GPTEDIT: GPT OK: %u entries, usable 0x%llx-0x%llx, backup header 0x%llx, entries 0x%llx/0x%llx\n",
+	    nent, rd64(gpt_ph + 40), rd64(gpt_ph + 48), alt, rd64(gpt_ph + 72), rd64(gpt_bh + 72));
+
+	int ud = -1, freeslot = -1;
+	char name[37];
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = gpt_ent + i * esz;
+		if (gpt_empty(e)) {
+			if (freeslot < 0) {
+				freeslot = (int)i;
+			}
+			continue;
+		}
+		gpt_name(e, name);
+		if (strcmp(name, "ios") == 0) {
+			printf("GPTEDIT: an \"ios\" partition already exists (#%u, 0x%llx-0x%llx)\n",
+			    i, rd64(e + 32), rd64(e + 40));
+			return EEXIST;
+		}
+		if (strcmp(name, "userdata") == 0) {
+			ud = (int)i;
+		}
+	}
+	if (ud < 0 || freeslot < 0) {
+		printf("GPTEDIT: userdata #%d, free slot #%d: cannot proceed\n", ud, freeslot);
+		return ENOENT;
+	}
+	uint8_t *u = gpt_ent + ud * esz;
+	uint64_t ufirst = rd64(u + 32), ulast = rd64(u + 40);
+	uint64_t shrink = (uint64_t)mib << 11;  /* MiB -> 512 B sectors */
+	if (mib < 1024 || ulast + 1 < ufirst + shrink + (8ull << 21)) {
+		printf("GPTEDIT: %u MiB does not fit (userdata 0x%llx-0x%llx)\n", mib, ufirst, ulast);
+		return EINVAL;
+	}
+	uint64_t ifirst = (ulast + 1 - shrink) & ~2047ull;      /* 1 MiB aligned */
+	uint64_t ilast = ulast, nulast = ifirst - 1;
+	/* The new range must not overlap anything but userdata itself. */
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = gpt_ent + i * esz;
+		if (i == (uint32_t)ud || gpt_empty(e)) {
+			continue;
+		}
+		if (rd64(e + 32) <= ilast && rd64(e + 40) >= ifirst) {
+			gpt_name(e, name);
+			printf("GPTEDIT: new range overlaps \"%s\"\n", name);
+			return EINVAL;
+		}
+	}
+	if (ilast > rd64(gpt_ph + 48)) {
+		printf("GPTEDIT: userdata ends past the last usable LBA\n");
+		return EINVAL;
+	}
+	printf("GPTEDIT: PLAN userdata #%d: 0x%llx-0x%llx (%llu MiB) -> 0x%llx-0x%llx (%llu MiB)\n",
+	    ud, ufirst, ulast, (ulast - ufirst + 1) >> 11, ufirst, nulast, (nulast - ufirst + 1) >> 11);
+	printf("GPTEDIT: PLAN new \"ios\" (HFS+) #%d: 0x%llx-0x%llx (%llu MiB)\n",
+	    freeslot, ifirst, ilast, (ilast - ifirst + 1) >> 11);
+
+	/* Build the new entry array (identical in both copies). */
+	wr64(u + 40, nulast);
+	uint8_t *n = gpt_ent + freeslot * esz;
+	bzero(n, esz);
+	static const uint8_t hfs[16] = { 0x00, 0x53, 0x46, 0x48, 0x00, 0x00, 0xaa, 0x11,
+		                         0xaa, 0x11, 0x00, 0x30, 0x65, 0x43, 0xec, 0xac };
+	memcpy(n, hfs, 16);
+	read_frandom(n + 16, 16);
+	n[16 + 7] = (uint8_t)((n[16 + 7] & 0x0f) | 0x40);      /* version 4 */
+	n[16 + 8] = (uint8_t)((n[16 + 8] & 0x3f) | 0x80);      /* RFC 4122 variant */
+	wr64(n + 32, ifirst);
+	wr64(n + 40, ilast);
+	n[56] = 'i'; n[58] = 'o'; n[60] = 's';
+	memcpy(gpt_bent, gpt_ent, nent * esz);
+	uint32_t oldcrc = rd32(gpt_ph + 88);
+	gpt_seal(gpt_ph, gpt_ent);
+	gpt_seal(gpt_bh, gpt_bent);
+	printf("GPTEDIT: entries CRC 0x%08x -> 0x%08x, headers 0x%08x/0x%08x\n",
+	    oldcrc, rd32(gpt_ph + 88), rd32(gpt_ph + 16), rd32(gpt_bh + 16));
+	if (mode != 2) {
+		printf("GPTEDIT: plan only (emmcgpt=1): nothing written\n");
+		return 0;
+	}
+	/* Backup copy first, primary last. */
+	if ((error = gpt_write_verify(rd64(gpt_bh + 72), gpt_bent, esec, "backup entries")) ||
+	    (error = gpt_write_verify(alt, gpt_bh, 1, "backup header")) ||
+	    (error = gpt_write_verify(rd64(gpt_ph + 72), gpt_ent, esec, "primary entries")) ||
+	    (error = gpt_write_verify(1, gpt_ph, 1, "primary header"))) {
+		return error;
+	}
+	/* Final check: both copies load and validate from the device. */
+	if ((error = gpt_load(1, gpt_ph, gpt_ent, "primary")) ||
+	    (error = gpt_load(alt, gpt_bh, gpt_bent, "backup"))) {
+		printf("GPTEDIT: re-validation FAILED (%d)\n", error);
+		return error;
+	}
+	printf("GPTEDIT: DONE: both GPT copies rewritten and validated\n");
+	return 0;
+}
