+static int
+emmc_gpt_split(uint32_t mode, uint32_t mib)
+{
+	int error;
+	if ((error = gpt_load(1, gpt_ph, gpt_ent, "primary"))) {
+		return error;
+	}
+	uint64_t alt = rd64(gpt_ph + 32);
