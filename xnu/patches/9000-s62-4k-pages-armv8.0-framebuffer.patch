+	kprintf("S62 FIX: GICD ISENABLER1..4=%x %x %x %x IPRIO(32)=%x\n",
+	    gicd_read32(0x104), gicd_read32(0x108), gicd_read32(0x10c), gicd_read32(0x110),
+	    gicd_read32(0x420));
