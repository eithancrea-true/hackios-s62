+/*
+ * S62 eMMC transport: the SDM660 SDCC1 host (sdhci-msm v5) is left running by
+ * ABL in transfer state, in the user data area, after loading our boot image.
+ * Standard SDHCI registers, programmed I/O, polled, one command at a time.
+ * Never touched: power control, HOST_CONTROL2 (signal voltage), RESET_ALL and
+ * the clock: on msm those wait for a power IRQ handshake we do not service.
+ */
+#define SD_SYSADDR      0x00            /* v4 mode: 32-bit block count */
+#define SD_ADMA_LO      0x58
+#define SD_ADMA_HI      0x5c
+#define SD_BLK          0x04            /* [15:0] size, [31:16] count */
+#define SD_ARG          0x08
+#define SD_CMD          0x0c            /* [15:0] transfer mode, [31:16] command */
+#define SD_RESP0        0x10
+#define SD_DATA         0x20
+#define SD_PSTATE       0x24
+#define SD_HCTL         0x28            /* host ctl1, power, gap, wakeup */
+#define SD_CLKCTL       0x2c            /* clock, timeout, [31:24] software reset */
+#define SD_INT          0x30            /* [15:0] normal, [31:16] error, W1C */
+#define SD_INTEN        0x34
+#define SD_SIGEN        0x38
+#define SD_HCTL2        0x3c            /* [31:16] host control 2 */
+#define SD_CAPS         0x40
+#define SD_VERSION      0xfc            /* [31:16] host version */
+
+#define PS_CMD_INHIBIT  (1u << 0)
+#define PS_DAT_INHIBIT  (1u << 1)
+#define PS_BUF_RD_EN    (1u << 11)              /* data available in the buffer */
+#define INT_CMD_DONE    (1u << 0)
+#define INT_XFER_DONE   (1u << 1)
+#define INT_BUF_RD      (1u << 5)
+#define INT_ERROR       (1u << 15)
+
+#define TM_DMA          (1u << 0)
+#define TM_BCE          (1u << 1)
+#define TM_ACMD12       (1u << 2)
+#define TM_READ         (1u << 4)
+#define TM_MULTI        (1u << 5)
+#define CMDF_R1         0x1a            /* 48-bit response, CRC and index check */
+#define CMDF_DATA       0x20
+
+#define R1_ERRORS       0xfdf90080u     /* card status error bits */
+#define EMMC_TIMEOUT_NS (2ull * NSEC_PER_SEC)
+
+#define GCC_SDCC1_PA    0x00116000      /* GCC 0x100000 + 0x16000 */
+#define GCC_SDCC1_APPS  0x004
+#define GCC_SDCC1_AHB   0x008
+#define CBCR_CLK_OFF    (1u << 31)
+#define CQ_CFG          0x08
+#define CQ_ENABLE       (1u << 0)
+
+static inline uint32_t
+emmc_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+emmc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static void
+emmc_reset_lines(void)
+{
+	/* Software reset of the CMD and DAT lines only (not RESET_ALL). */
+	emmc_wr(SD_CLKCTL, (emmc_rd(SD_CLKCTL) & 0x00ffffffu) | (0x06u << 24));
+	uint64_t deadline;
+	nanoseconds_to_deadline(EMMC_TIMEOUT_NS, &deadline);
+	while ((emmc_rd(SD_CLKCTL) >> 24) & 0x06) {
+		if (mach_absolute_time() > deadline) {
+			break;
+		}
+	}
+	emmc_wr(SD_INT, 0xffffffffu);
+}
+
+/* Wait for any of the normal status bits in want, or an error. */
+static int
+emmc_wait(uint32_t want, const char *what)
+{
+	uint64_t deadline;
+	nanoseconds_to_deadline(EMMC_TIMEOUT_NS, &deadline);
+	for (;;) {
+		uint32_t st = emmc_rd(SD_INT);
+		if (st & INT_ERROR) {
+			printf("SWEET EMMC: %s error, status 0x%08x pstate 0x%08x\n",
+			    what, st, emmc_rd(SD_PSTATE));
+			emmc_reset_lines();
+			return EIO;
+		}
+		if (st & want) {
+			return 0;
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET EMMC: %s timeout, status 0x%08x pstate 0x%08x\n",
+			    what, st, emmc_rd(SD_PSTATE));
+			emmc_reset_lines();
+			return ETIMEDOUT;
+		}
+	}
+}
+
+/*
+ * ADMA2 descriptor table at DMA_UTRL (unused by the eMMC path) describing
+ * len bytes of the bounce buffer, in 32 KiB pieces. DMA select (HOST_CONTROL1
+ * bits 4:3) is left as ABL set it: 3 = 64-bit descriptors (12 bytes),
+ * 2 = 32-bit descriptors (8 bytes).
+ */
+#define ADMA_CHUNK      (32u << 10)
+#define ADMA_VALID      0x01
+#define ADMA_END        0x02
+#define ADMA_TRAN       0x20
+
+static int
+emmc_adma_prepare(uint32_t len)
+{
+	uint32_t sel = (emmc_rd(SD_HCTL) >> 3) & 3;
+	uint32_t dsz = sel == 3 ? 12 : 8;
+	uint64_t data = su.dma_pa + DMA_BOUNCE;
+	if ((sel != 2 && sel != 3) || (sel == 2 && ((data + len - 1) >> 32)) ||
+	    (len + ADMA_CHUNK - 1) / ADMA_CHUNK * dsz > DMA_UCD - DMA_UTRL) {
+		printf("SWEET EMMC: unsupported DMA select %u\n", sel);
+		return EINVAL;
+	}
+	uint8_t *t = (uint8_t *)(su.dma + DMA_UTRL);
+	uint32_t n = 0;
+	for (uint32_t off = 0; off < len; off += ADMA_CHUNK, n++) {
+		uint32_t piece = MIN(ADMA_CHUNK, len - off);
+		uint16_t attr = ADMA_VALID | ADMA_TRAN | (off + piece >= len ? ADMA_END : 0);
+		uint16_t l16 = (uint16_t)piece;
+		uint64_t a = data + off;
+		uint8_t *d = t + n * dsz;
+		memcpy(d, &attr, 2);
+		memcpy(d + 2, &l16, 2);
+		memcpy(d + 4, &a, dsz - 4);
+	}
+	dma_clean(DMA_UTRL, n * dsz);
+	dma_sync(DMA_BOUNCE, len);      /* no dirty lines over the DMA target */
+	uint64_t tpa = su.dma_pa + DMA_UTRL;
+	emmc_wr(SD_ADMA_LO, (uint32_t)tpa);
+	emmc_wr(SD_ADMA_HI, (uint32_t)(tpa >> 32));
+	return 0;
+}
+
+/* One command with an R1 response; moves count sectors (read or write) when count != 0. */
+static int
+emmc_cmd_data(uint32_t idx, uint32_t arg, uint32_t count, void *buf, bool write)
+{
+	uint64_t deadline;
+	uint32_t inhibit = PS_CMD_INHIBIT | (count ? PS_DAT_INHIBIT : 0);
+	nanoseconds_to_deadline(EMMC_TIMEOUT_NS, &deadline);
+	while (emmc_rd(SD_PSTATE) & inhibit) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET EMMC: CMD%u: host busy, pstate 0x%08x\n", idx, emmc_rd(SD_PSTATE));
+			emmc_reset_lines();
+			return EBUSY;
+		}
+	}
+	emmc_wr(SD_INT, 0xffffffffu);
+
+	uint32_t mode = 0, flags = CMDF_R1;
+	if (count) {
+		emmc_wr(SD_BLK, (count << 16) | EMMC_BLOCK);
+		if (emmc_rd(SD_HCTL2) & (1u << 28)) {   /* Host Version 4 Enable */
+			emmc_wr(SD_SYSADDR, count);
+		}
+		if (buf != (void *)(su.dma + DMA_BOUNCE) || emmc_adma_prepare(count * EMMC_BLOCK)) {
+			return EINVAL;
+		}
+		mode = TM_DMA | (write ? 0 : TM_READ) | TM_BCE | (count > 1 ? (TM_MULTI | TM_ACMD12) : 0);
+		flags |= CMDF_DATA;
+	}
+	emmc_wr(SD_ARG, arg);
+	emmc_wr(SD_CMD, mode | (((idx << 8) | flags) << 16));
+
+	int error = emmc_wait(INT_CMD_DONE, "command");
+	if (error) {
+		return error;
+	}
+	uint32_t r1 = emmc_rd(SD_RESP0);
+	emmc_wr(SD_INT, INT_CMD_DONE);
+	if (r1 & R1_ERRORS) {
+		printf("SWEET EMMC: CMD%u arg 0x%x: card status 0x%08x\n", idx, arg, r1);
+		if (count) {
+			emmc_reset_lines();
+		}
+		return EIO;
+	}
+	if (count == 0) {
+		return 0;
+	}
+	/*
+	 * Data arrives by ADMA2 (set up by emmc_cmd_read's caller through
+	 * emmc_adma_prepare). PIO does not work on this host: buffer-read-enable
+	 * stays set and the data port only returns zeros.
+	 */
+	static bool diag_done;
+	nanoseconds_to_deadline(EMMC_TIMEOUT_NS, &deadline);
+	uint32_t st;
+	while (!((st = emmc_rd(SD_INT)) & (INT_XFER_DONE | INT_ERROR))) {
+		if (mach_absolute_time() > deadline) {
+			error = ETIMEDOUT;
+			break;
+		}
+	}
+	if (st & INT_ERROR) {
+		error = EIO;
+	}
+	if (!error && !write) {
+		dma_sync(DMA_BOUNCE, count * EMMC_BLOCK);
+	}
+	if (!diag_done || error) {
+		const uint8_t *d = buf;
+		printf("SWEET EMMC: CMD%u n=%u ADMA int 0x%08x pstate 0x%08x adma_err 0x%x%s\n",
+		    idx, count, st, emmc_rd(SD_PSTATE), emmc_rd(0x54) & 0xff,
+		    error == ETIMEDOUT ? " TIMEOUT" : "");
+		if (!error) {
+			printf("SWEET EMMC: data %02x%02x%02x%02x %02x%02x%02x%02x ... [510]=%02x%02x\n",
+			    d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[510], d[511]);
+		}
+		diag_done = true;
+	}
+	if (error) {
+		emmc_reset_lines();
+	}
+	emmc_wr(SD_INT, INT_XFER_DONE);
+	return error;
+}
+
+static int
+emmc_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (count == 0 || count > BOUNCE_SIZE / EMMC_BLOCK || lba + count > UINT32_MAX) {
+		return EINVAL;
+	}
+	/* High capacity eMMC: sector addressing. */
+	return emmc_cmd_data(count > 1 ? 18 : 17, (uint32_t)lba, count,
+	           (void *)(su.dma + DMA_BOUNCE), false);
+}
+
+/*
+ * Write count sectors from the bounce buffer. No bounds of its own: callers
+ * are ufs_write_blocks() (partition bounds) and the GPT editor (GPT sectors).
+ * For writes SDHCI raises transfer complete only after the card's busy ends.
+ */
+static int
+emmc_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (count == 0 || count > BOUNCE_SIZE / EMMC_BLOCK || lba + count > UINT32_MAX) {
+		return EINVAL;
+	}
+	return emmc_cmd_data(count > 1 ? 25 : 24, (uint32_t)lba, count,
+	           (void *)(su.dma + DMA_BOUNCE), true);
+}
+
+/* Check that ABL left the host clocked and idle, and in legacy (non-CQ) mode. */
+static int
+emmc_take_over_host(void)
+{
+	uint32_t apps = *(volatile uint32_t *)(su.gcc + GCC_SDCC1_APPS);
+	uint32_t ahb = *(volatile uint32_t *)(su.gcc + GCC_SDCC1_AHB);
+	printf("SWEET EMMC: GCC SDCC1 apps 0x%08x ahb 0x%08x ice 0x%08x\n", apps, ahb,
+	    *(volatile uint32_t *)(su.gcc + 0x00c));
+	if ((apps | ahb) & CBCR_CLK_OFF) {
+		/* Touching an unclocked host can hang the bus: stop here. */
+		printf("SWEET EMMC: SDCC1 clocks are off, not touching the host\n");
+		return ENXIO;
+	}
+	printf("SWEET EMMC: version 0x%x caps 0x%08x pstate 0x%08x hctl 0x%08x\n",
+	    emmc_rd(SD_VERSION) >> 16, emmc_rd(SD_CAPS), emmc_rd(SD_PSTATE), emmc_rd(SD_HCTL));
+	printf("SWEET EMMC: clkctl 0x%08x hctl2 0x%08x int 0x%08x inten 0x%08x sigen 0x%08x\n",
+	    emmc_rd(SD_CLKCTL), emmc_rd(SD_HCTL2), emmc_rd(SD_INT), emmc_rd(SD_INTEN),
+	    emmc_rd(SD_SIGEN));
+	uint32_t cqcfg = *(volatile uint32_t *)(su.cq + CQ_CFG);
+	printf("SWEET EMMC: CQ cfg 0x%08x\n", cqcfg);
+	if (cqcfg & CQ_ENABLE) {
+		printf("SWEET EMMC: command queue enabled by the bootloader, disabling\n");
+		*(volatile uint32_t *)(su.cq + CQ_CFG) = cqcfg & ~CQ_ENABLE;
+	}
+	if (!(emmc_rd(SD_CLKCTL) & (1u << 2))) {
+		printf("SWEET EMMC: card clock is off\n");
+		return ENXIO;
+	}
+	/* Status latching for what we poll; no interrupt signals. */
+	emmc_wr(SD_INTEN, (0x03ffu << 16) | INT_CMD_DONE | INT_XFER_DONE | INT_BUF_RD);
+	emmc_wr(SD_INT, 0xffffffffu);
+	return 0;
+}
