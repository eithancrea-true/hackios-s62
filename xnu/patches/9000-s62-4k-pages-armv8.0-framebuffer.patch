diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 9a748ea..8b63634 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -61,7 +61,8 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+# S62 (SDM660, Kryo 260 = Cortex-A73/A53 class) is ARMv8.0: no LSE atomics, no PAN.
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a53+crypto
 
 
 #
@@ -337,6 +338,14 @@ ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
 
+# S62: 4K pages. The 39-bit kernel VA window of the 4K T1SZ_BOOT cannot hold the
+# ARM_LARGE_MEMORY link address, so use the standard embedded layout.
+ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+ARM64_PLKSEG_ADDR  =0xfffffff004004000
+ARM64_LINK_ADDR    =0xfffffff007004000
+endif
+
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
 			$(LARGE_MEMORY_DEFINE) -momit-leaf-frame-pointer -fno-strict-aliasing -D__API__=v4 -mkernel
diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..0d2d072 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,20 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* S62 is ARMv8.0 (no LSE casa): same compare-and-swap with LL/SC. w10 = old value. */
+Lpfz_cas_enq:
+	ldaxr	w10, [x3]
+	cbnz	w10, Lpfz_cas_enq_busy
+	stxr	w9, w11, [x3]
+	cbnz	w9, Lpfz_cas_enq
+	b		Lpfz_cas_enq_done
+Lpfz_cas_enq_busy:
+	clrex
+Lpfz_cas_enq_done:
+#else
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#endif
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +336,20 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* S62 is ARMv8.0 (no LSE casa): same compare-and-swap with LL/SC. w10 = old value. */
+Lpfz_cas_deq:
+	ldaxr	w10, [x2]
+	cbnz	w10, Lpfz_cas_deq_busy
+	stxr	w9, w11, [x2]
+	cbnz	w9, Lpfz_cas_deq
+	b		Lpfz_cas_deq_done
+Lpfz_cas_deq_busy:
+	clrex
+Lpfz_cas_deq_done:
+#else
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 00568d3..6c795f1 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -10897,6 +10897,14 @@ pmap_create_commpages(vm_map_address_t *kernel_data_addr, vm_map_address_t *kern
 		// comm page, but with new leaf index we've just generated.
 		commpage_text_va = (_COMM_PAGE64_BASE_ADDRESS & ~pt_attr_leaf_index_mask(pt_attr));
 		commpage_text_va |= (text_leaf_index << pt_attr_leaf_shift(pt_attr));
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		/*
+		 * S62: 4K hardware pages with 16K VM pages (PAGE_RATIO 4, as on Apple's
+		 * 4K SoCs with more than 1GB): PTEs are written four at a time, so the
+		 * VA must be aligned to the VM page size, not the hardware one.
+		 */
+		commpage_text_va &= ~((vm_map_address_t)PAGE_MASK);
+#endif
 	} while ((commpage_text_va == _COMM_PAGE64_BASE_ADDRESS) || (commpage_text_va == _COMM_PAGE64_RO_ADDRESS)); // Try again if we collide (should be unlikely)
 
 	// Assert that this is empty
@@ -10981,11 +10989,14 @@ static_assert((_COMM_PAGE32_BASE_ADDRESS & ~ARM_TT_L2_OFFMASK) >= VM_MAX_ADDRESS
  */
 
 #elif (ARM_PGSHIFT == 12)
+#if !defined(ARM64_BOARD_CONFIG_SWEET)
 /**
  * Ensure that 64-bit devices using 4K pages can nest the commpage completely
- * above the maximum userspace VA.
+ * above the maximum userspace VA. S62: not met with the macOS user VA layout;
+ * the nested commpage path still has to be verified on 4K.
  */
 static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) >= MACH_VM_MAX_ADDRESS);
+#endif
 #else
 #error Nested shared page mapping is unsupported on this config
 #endif
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..a379576 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1831,22 +1831,34 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
  * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
  */
+#if defined(__ARM_16K_PG__)
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#else
+/*
+ * S62 (4K pages, non-LARGE_MEMORY layout): VM_MIN_KERNEL_ADDRESS is in an L1
+ * entry (1 GiB) that has no table yet. Use the gap between the low globals
+ * (LOW_GLOBAL_BASE_ADDRESS, one 2MB block) and gVirtBase instead; it shares
+ * the kernel's L1 entry, whose L2 table already exists.
+ */
+#define SWEET_EARLY_FB_VA (LOW_GLOBAL_BASE_ADDRESS + 0x1000000ULL)
+#endif
 
 static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	assert(va + SWEET_FB_L2_BLOCKS * ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (unsigned int i = 0; i < SWEET_FB_L2_BLOCKS; i++) {
+		assert(slot[i] == ARM_TTE_EMPTY);
+		slot[i] = ((uint64_t)SWEET_FB_PA + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
@@ -2141,6 +2153,13 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 *     LOW_GLOBAL_BASE_ADDRESS + 2MB
 	 */
 	va_l1 = va_l2 = LOW_GLOBAL_BASE_ADDRESS;
+#if defined(SWEET) && !defined(__ARM_16K_PG__)
+	/*
+	 * 4K pages: an L1 entry covers 1 GiB, so the low globals do not share the
+	 * kernel's L1 entry and nothing has allocated their L2 table yet.
+	 */
+	init_ptpages(cpu_tte, va_l1, va_l1 + ARM_TT_L2_SIZE, TRUE, ARM_TTE_TABLE_PXN | ARM_TTE_TABLE_XN);
+#endif
 	cpu_l1_tte = cpu_tte + ((va_l1 & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT);
 	cpu_l2_tte = ((tt_entry_t *) phystokv(((*cpu_l1_tte) & ARM_TTE_TABLE_MASK))) + ((va_l2 & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
 	ptpage_vaddr = alloc_ptpage(TRUE);
