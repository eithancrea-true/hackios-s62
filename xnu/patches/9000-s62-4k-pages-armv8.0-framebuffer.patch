+/*
+ * Write the SGI/PPI configuration again and read it back at once. If it sticks
+ * now, the first write was lost (wrong frame or reset); if it still reads 0,
+ * the non-secure side cannot program these interrupts (Secure Group 0).
+ */
+boolean_t
+sweet_gic_retry(void)
+{
+	vm_offset_t gicr_pe_base = find_gicr_pe_base();
+	uint32_t want = (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI);
+	gicr_write32(GICR_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicr_write32(GICR_ISENABLER0, want);
+	__builtin_arm_dsb(DSB_SY);
+	uint32_t en = gicr_read32(GICR_ISENABLER0);
+	kprintf("S62 FIX: rewrite -> ISENABLER0=%x IPRIO0=%x IPRIO16=%x IGROUPR0=%x\n",
+	    en, gicr_read32(GICR_IPRIORITYR0), gicr_read32(GICR_IPRIORITYR0 + 16),
+	    gicr_read32(GICR_IGROUPR0));
