+/*
+ * S62 GPT editor (boot-arg emmcgpt=1 plan, =2 apply; emmcgptmib= size of the
+ * new partition, default 16384). Moves the end of "userdata" down and adds an
+ * HFS+ partition named "ios" in the freed space, in a free entry slot.
+ * Everything is validated first (both headers and both entry arrays, CRCs,
+ * no overlap); the only sectors ever written are the two GPT entry arrays and
+ * headers, the backup first and the primary last, each read back and compared.
+ */
+#include <sys/random.h>
+
+static uint8_t gpt_ph[EMMC_BLOCK], gpt_bh[EMMC_BLOCK];
+static uint8_t gpt_ent[128 * 128], gpt_bent[128 * 128];
+
+static uint32_t
+gpt_crc32(const uint8_t *p, size_t n)
+{
+	uint32_t c = 0xffffffffu;
+	while (n--) {
+		c ^= *p++;
+		for (int k = 0; k < 8; k++) {
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1)));
+		}
+	}
+	return ~c;
+}
+
+static inline uint32_t
+rd32(const uint8_t *p)
+{
+	uint32_t v; memcpy(&v, p, 4); return v;
+}
+static inline uint64_t
+rd64(const uint8_t *p)
+{
+	uint64_t v; memcpy(&v, p, 8); return v;
+}
+static inline void
+wr32(uint8_t *p, uint32_t v)
+{
+	memcpy(p, &v, 4);
+}
+static inline void
+wr64(uint8_t *p, uint64_t v)
+{
+	memcpy(p, &v, 8);
+}
+
+static void
+gpt_name(const uint8_t *e, char *out)
+{
+	unsigned c;
+	for (c = 0; c < 36; c++) {
+		uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+		if (ch == 0 || ch > 0x7f) {
+			break;
+		}
+		out[c] = (char)ch;
+	}
+	out[c] = 0;
+}
+
+static bool
+gpt_empty(const uint8_t *e)
+{
+	for (int i = 0; i < 16; i++) {
+		if (e[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Read and fully validate one header and its entries. */
+static int
+gpt_load(uint64_t hlba, uint8_t *hdr, uint8_t *ent, const char *which)
+{
+	int error = emmc_read_blocks(hlba, 1);
+	if (error) {
+		return error;
+	}
+	memcpy(hdr, (void *)(su.dma + DMA_BOUNCE), EMMC_BLOCK);
+	uint32_t hsize = rd32(hdr + 12), hcrc = rd32(hdr + 16);
+	uint32_t nent = rd32(hdr + 80), esz = rd32(hdr + 84);
+	if (memcmp(hdr, "EFI PART", 8) != 0 || hsize < 92 || hsize > EMMC_BLOCK ||
+	    esz != 128 || nent == 0 || nent > 128 || rd64(hdr + 24) != hlba) {
+		printf("GPTEDIT: %s header at 0x%llx invalid\n", which, hlba);
+		return EINVAL;
+	}
+	uint8_t tmp[EMMC_BLOCK];
+	memcpy(tmp, hdr, hsize);
+	wr32(tmp + 16, 0);
+	if (gpt_crc32(tmp, hsize) != hcrc) {
+		printf("GPTEDIT: %s header CRC mismatch\n", which);
+		return EINVAL;
+	}
+	uint32_t bytes = nent * esz, sectors = (bytes + EMMC_BLOCK - 1) / EMMC_BLOCK;
+	error = emmc_read_blocks(rd64(hdr + 72), sectors);
+	if (error) {
+		return error;
+	}
+	memcpy(ent, (void *)(su.dma + DMA_BOUNCE), sectors * EMMC_BLOCK);
+	if (gpt_crc32(ent, bytes) != rd32(hdr + 88)) {
+		printf("GPTEDIT: %s entries CRC mismatch\n", which);
+		return EINVAL;
+	}
+	return 0;
+}
+
+static void
+gpt_seal(uint8_t *hdr, const uint8_t *ent)
+{
+	wr32(hdr + 88, gpt_crc32(ent, rd32(hdr + 80) * rd32(hdr + 84)));
+	wr32(hdr + 16, 0);
+	wr32(hdr + 16, gpt_crc32(hdr, rd32(hdr + 12)));
+}
+
+/* Write sectors from buf, then read them back and compare. */
+static int
+gpt_write_verify(uint64_t lba, const uint8_t *buf, uint32_t sectors, const char *what)
+{
+	memcpy((void *)(su.dma + DMA_BOUNCE), buf, sectors * EMMC_BLOCK);
+	int error = emmc_write_blocks(lba, sectors);
+	if (!error) {
+		bzero((void *)(su.dma + DMA_BOUNCE), sectors * EMMC_BLOCK);
+		error = emmc_read_blocks(lba, sectors);
+	}
+	if (!error && memcmp((void *)(su.dma + DMA_BOUNCE), buf, sectors * EMMC_BLOCK) != 0) {
+		error = EIO;
+	}
+	printf("GPTEDIT: write %s (%u sectors at 0x%llx): %s (%d)\n", what, sectors, lba,
+	    error ? "FAILED" : "verified", error);
+	return error;
+}
