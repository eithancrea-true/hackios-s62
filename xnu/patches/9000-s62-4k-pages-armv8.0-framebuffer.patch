+		kprintf("S62 GIC: not initialized\n");
+		return;
+	}
+	vm_offset_t gicr_pe_base = find_gicr_pe_base();
+	kprintf("S62 EARLY: off=%lx WAKER=%x ISENABLER0=%x IPRIO0=%x\n",
+	    s62_early_off, s62_early_waker, s62_early_en, s62_early_pri);
+	for (vm_offset_t o = 0; o + 0x20000 <= gicr_size && o < 0x100000; o += 0x20000) {
+		kprintf("S62 FRAME %lx: TYPER=%llx WAKER=%x EN0=%x PEND0=%x\n", (unsigned long)o,
+		    _gic_read64(gicr_base + o + GICR_TYPER), _gic_read32(gicr_base + o + GICR_WAKER),
+		    _gic_read32(gicr_base + o + GICR_ISENABLER0), _gic_read32(gicr_base + o + 0x10200));
+		if (_gic_read64(gicr_base + o + GICR_TYPER) & GICR_TYPER_LAST) {
+			break;
+		}
+	}
+	kprintf("S62 GIC: GICD_CTLR=%x TYPER=%x IIDR=%x\n",
+	    gicd_read32(0x0), gicd_read32(0x4), gicd_read32(0x8));
+	kprintf("S62 GIC: GICR off=%lx TYPER=%llx WAKER=%x CTLR=%x\n",
+	    (unsigned long)(gicr_pe_base - gicr_base), gicr_read64(GICR_TYPER),
+	    gicr_read32(GICR_WAKER), gicr_read32(0x0));
+	kprintf("S62 GIC: IGROUPR0=%x ISENABLER0=%x ISPENDR0=%x ISACTIVER0=%x\n",
+	    gicr_read32(GICR_IGROUPR0), gicr_read32(GICR_ISENABLER0),
+	    gicr_read32(0x10200), gicr_read32(0x10300));
+	kprintf("S62 GIC: IPRIORITYR0=%x R4(16-19)=%x IGRPMODR0=%x\n",
+	    gicr_read32(GICR_IPRIORITYR0), gicr_read32(GICR_IPRIORITYR0 + 16), gicr_read32(0x10d00));
+	kprintf("S62 GIC: ICC_SRE=%llx IGRPEN1=%llx PMR=%llx CTLR=%llx\n",
+	    __builtin_arm_rsr64("ICC_SRE_EL1"), __builtin_arm_rsr64("ICC_IGRPEN1_EL1"),
+	    __builtin_arm_rsr64("ICC_PMR_EL1"), __builtin_arm_rsr64("ICC_CTLR_EL1"));
+	kprintf("S62 GIC: HPPIR1=%llx RPR=%llx BPR1=%llx DAIF=%llx\n",
+	    __builtin_arm_rsr64("ICC_HPPIR1_EL1"), __builtin_arm_rsr64("ICC_RPR_EL1"),
+	    __builtin_arm_rsr64("ICC_BPR1_EL1"), __builtin_arm_rsr64("DAIF"));
+	kprintf("S62 TMR: CNTV_CTL=%llx CVAL=%llx CNTVCT=%llx\n",
+	    __builtin_arm_rsr64("CNTV_CTL_EL0"), __builtin_arm_rsr64("CNTV_CVAL_EL0"),
+	    __builtin_arm_rsr64("CNTVCT_EL0"));
+	kprintf("S62 TMR: CNTP_CTL=%llx CNTFRQ=%llx CNTKCTL=%llx EL=%llx\n",
+	    __builtin_arm_rsr64("CNTP_CTL_EL0"), __builtin_arm_rsr64("CNTFRQ_EL0"),
+	    __builtin_arm_rsr64("CNTKCTL_EL1"), __builtin_arm_rsr64("CurrentEL") >> 2);
+}
